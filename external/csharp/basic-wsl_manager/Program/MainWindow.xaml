<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Program" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Class="Program.MainWindow"
	Title="WSL Manager"
	Width="1000"
	Height="600"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="78" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<!-- ========================================================= -->
		<!-- MENU                                                       -->
		<!-- ========================================================= -->
		<Menu
			Grid.Row="0">
			<MenuItem
				Header="Distro">
				<MenuItem
					Click="NewDistro_Click"
					Header="New Distro" />
				<MenuItem
					Click="Import_Click"
					Header="Import Distro" />
				<Separator />
				<MenuItem
					Click="Refresh_Click"
					Header="Refresh" />
				<Separator />
				<MenuItem
					Click="Exit_Click"
					Header="Exit" />
			</MenuItem>
			<MenuItem
				Header="Tools">
				<MenuItem
					Click="WslConsole_Click"
					Header="WSL Console" />
				<MenuItem
					Click="LxRunOfflineConsole_Click"
					Header="LxRunOffline Console" />
				<Separator />
				<MenuItem
					Header="Settings" />
			</MenuItem>
			<MenuItem
				Header="Help">
				<MenuItem
					Click="Documentation_Click"
					Header="WSL Documentation" />
				<MenuItem
					Click="About_Click"
					Header="About" />
			</MenuItem>
		</Menu>
		<!-- ========================================================= -->
		<!-- BIG TOOLBAR                                                -->
		<!-- ========================================================= -->
		<ToolBar
			Grid.Row="1"
			Padding="8"
			VerticalContentAlignment="Center">
			<Button
				Width="80"
				Height="62"
				Margin="3"
				ToolTip="Create a new distribution">
				<StackPanel
					HorizontalAlignment="Center">
					<TextBlock
						Text="+"
						FontFamily="Segoe UI"
						FontSize="28"
						HorizontalAlignment="Center" />
					<TextBlock
						Text="New"
						HorizontalAlignment="Center" />
				</StackPanel>
			</Button>
			<Button
				Width="80"
				Height="62"
				Margin="3"
				ToolTip="Start distribution">
				<StackPanel
					HorizontalAlignment="Center">
					<TextBlock
						Text="&#xE174;"
						FontFamily="Segoe UI"
						FontSize="16"
						HorizontalAlignment="Center" />
					<TextBlock
						HorizontalAlignment="Center">
						<Run
							Text="Start" />
					</TextBlock>
				</StackPanel>
			</Button>
			<Button
				Width="80"
				Height="62"
				Margin="3"
				ToolTip="Stop distribution">
				<StackPanel
					HorizontalAlignment="Center">
					<TextBlock
						Text="&#xE102;"
						FontFamily="Segoe UI"
						FontSize="25"
						HorizontalAlignment="Center" />
					<TextBlock
						HorizontalAlignment="Center">
						<Run
							Text="Stop" />
					</TextBlock>
				</StackPanel>
			</Button>
			<Separator />
			<Button
				Width="80"
				Height="62"
				Margin="3"
				Click="Refresh_Click"
				ToolTip="Refresh WSL information">
				<StackPanel
					HorizontalAlignment="Center">
					<TextBlock
						Text="&#xE103;"
						FontSize="28"
						FontFamily="Segoe UI"
						HorizontalAlignment="Center" />
					<TextBlock
						Text="Refresh"
						HorizontalAlignment="Center" />
				</StackPanel>
			</Button>
			<Separator />
			<Button
				Width="80"
				Height="62"
				Margin="3"
				ToolTip="Open WSL console">
				<StackPanel
					HorizontalAlignment="Center">
					<TextBlock
						Text="⌘"
						FontSize="25"
						HorizontalAlignment="Center" />
					<TextBlock
						Text="Console"
						HorizontalAlignment="Center" />
				</StackPanel>
			</Button>
			<Button
				Width="80"
				Height="62"
				Margin="3"
				ToolTip="Settings">
				<StackPanel
					HorizontalAlignment="Center">
					<TextBlock
						Text="⚙"
						FontSize="25"
						HorizontalAlignment="Center" />
					<TextBlock
						Text="Settings"
						HorizontalAlignment="Center" />
				</StackPanel>
			</Button>
		</ToolBar>
		<!-- ========================================================= -->
		<!-- MAIN AREA                                                  -->
		<!-- ========================================================= -->
		<Grid
			Grid.Row="2">
			<Grid.ColumnDefinitions>
				<!-- approximately 40% -->
				<ColumnDefinition
					Width="2*" />
				<!-- approximately 60% -->
				<ColumnDefinition
					Width="3*" />
			</Grid.ColumnDefinitions>
			<!-- ===================================================== -->
			<!-- DISTRO LIST                                            -->
			<!-- ===================================================== -->
			<Border
				Grid.Column="0"
				BorderBrush="#D0D0D0"
				BorderThickness="0,1,1,0">
				<ListBox
					Name="distroList"
					BorderThickness="0"
					VerticalContentAlignment="Top"
					HorizontalContentAlignment="Stretch"
					MouseDoubleClick="DistroListBox_MouseDoubleClick">
					<ListBox.ContextMenu>
						<ContextMenu>
							<MenuItem
								Header="Open"
								Click="Open_Click" />
							<MenuItem
								Header="Open Folder"
								Click="OpenFolder_Click" />
							<MenuItem
								Header="Explore"
								Click="Explore_Click" />
							<Separator />
							<MenuItem
								Header="Rename"
								Click="Rename_Click" />
							<MenuItem
								Header="Move"
								Click="Move_Click" />
							<MenuItem
								Header="Duplicate"
								Click="Duplicate_Click" />
							<Separator />
							<MenuItem
								Header="Export"
								Click="Export_Click" />
							<Separator />
							<MenuItem
								Header="Terminate"
								Click="Terminate_Click" />
							<MenuItem
								Header="Unregister"
								Click="Unregister_Click" />
							<MenuItem
								Header="Delete"
								Click="Delete_Click" />
							<Separator />
							<MenuItem
								Header="Properties"
								Click="Properties_Click" />
						</ContextMenu>
					</ListBox.ContextMenu>
					<!-- ============================================= -->
					<!-- DISTRO CARD                                    -->
					<!-- ============================================= -->
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border
								Margin="5"
								Padding="8"
								BorderBrush="#D8D8D8"
								BorderThickness="1"
								CornerRadius="3">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="65" />
										<ColumnDefinition
											Width="*" />
									</Grid.ColumnDefinitions>
									<Image
										Grid.Column="0"
										Width="50"
										Height="50"
										Source="{Binding DistroImage}"
										Stretch="Uniform" />
									<StackPanel
										Grid.Column="1"
										Margin="10,0,0,0">
										<TextBlock
											FontSize="15"
											FontWeight="SemiBold"
											Text="{Binding DistroName}" />
										<TextBlock
											Margin="0,5,0,0"
											FontSize="12"
											Text="{Binding DistroState}" />
										<TextBlock
											Margin="0,3,0,0"
											FontSize="11"
											Foreground="Gray"
											Text="{Binding DistroWslVersion,&#xD;&#xA;                                                   StringFormat='WSL {0}'}" />
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Border>
			<!-- ===================================================== -->
			<!-- DETAILS                                                -->
			<!-- ===================================================== -->
			<Border
				Grid.Column="1"
				Padding="20"
				BorderBrush="#D0D0D0"
				BorderThickness="0,1,0,0">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="20" />
						<RowDefinition
							Height="*" />
					</Grid.RowDefinitions>
					<TextBlock
						Grid.Row="0"
						FontSize="22"
						FontWeight="SemiBold"
						Text="Distro Details" />
					<!-- Dummy details for the visual experiment -->
					<Grid
						Grid.Row="2">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="140" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							FontWeight="SemiBold"
							Text="Name" />
						<TextBlock
							Grid.Row="0"
							Grid.Column="1"
							Text="Ubuntu" />
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Margin="0,10,0,0"
							FontWeight="SemiBold"
							Text="State" />
						<TextBlock
							Grid.Row="1"
							Grid.Column="1"
							Margin="0,10,0,0"
							Text="Running" />
						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Margin="0,10,0,0"
							FontWeight="SemiBold"
							Text="WSL Version" />
						<TextBlock
							Grid.Row="2"
							Grid.Column="1"
							Margin="0,10,0,0"
							Text="2" />
						<TextBlock
							Grid.Row="3"
							Grid.Column="0"
							Margin="0,10,0,0"
							FontWeight="SemiBold"
							Text="GUID" />
						<TextBlock
							Grid.Row="3"
							Grid.Column="1"
							Margin="0,10,0,0"
							Text="00000000-0000-0000-0000-000000000000" />
						<TextBlock
							Grid.Row="4"
							Grid.Column="0"
							Margin="0,10,0,0"
							FontWeight="SemiBold"
							Text="Image" />
						<TextBlock
							Grid.Row="4"
							Grid.Column="1"
							Margin="0,10,0,0"
							Text="C:\WSL\Ubuntu\ext4.vhdx" />
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>