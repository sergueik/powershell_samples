<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <appSettings>
    <add key="Debug" value="False"/>
    <add key="Rounds" value="1000"/>
    <add key="StopWslAsyncWait" value="1000"/>
    <add key="AverageInterval" value="30000"/>
    <add key="Datafile" value="${temp}\loadaverage.csv"/>
    <add key="CounterName" value="Working Set"/>
    <add key="CategoryName" value="Process"/>
    <add key="InstanceName" value="java#1"/>
    <add key="Argument" value="aplication-0.1.0-SNAPSHOT.jar"/>
    <add key="TargetUrl" value="http://192.168.12.159:9091/metrics/job/myapp"/>
  </appSettings>
</configuration>