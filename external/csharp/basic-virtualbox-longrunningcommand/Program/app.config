<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <appSettings>
    <add key="Debug" value="False"/>
    <add key="Noop" value="False"/>
    <add key="Autorun" value="False"/>
    <add key="Vm" value="{7e261a39-d356-4eb1-a8ed-75675b149241}"/>
    <add key="VmName" value="&quot;Xubuntu 22.04&quot;"/>
    <add key="ToolPath" value="%PROGRAMFILES%\Oracle\VirtualBox"/>
    <add key="FileName" value="vboxmanage.exe"/>
    <add key="RunCommand" value="Arguments5"/>
    <add key="Arguments1" value="list vms"/>
    <add key="Arguments4" value="guestcontrol %VM% run --username %USERNAME% --password %PASSWORD% --exe /bin/sh -- /bin/sh -c &quot;/tmp/a.sh sample&quot;"/>
    <add key="Arguments5" value="guestcontrol %VM% run --username %USERNAME% --password %PASSWORD% --exe /bin/sh -- /bin/sh -c &quot;%SCRIPT% %SCRIPTARGUMENTS%&quot;"/>
    <add key="Arguments6" value="guestcontrol %VM% run --username %USERNAME% --password %PASSWORD% --exe /bin/sh -- /bin/sh -c &quot;C=$1; which $C &gt;/dev/null 2&gt;&amp;1; if [ $? = 0 ]; then $C info &gt;/dev/null 2&gt;&amp;1; echo $?; else echo 1; fi&quot; &quot;test&quot; &quot;podman&quot;"/>
    <add key="Arguments7" value="showmediuminfo %VM%"/>
    <add key="Arguments8" value="showvminfo %VM% --machinereadable"/>
    <add key="Arguments9" value="list modifyhd %HDD%"/>
    <add key="Arguments10" value="guestcontrol %VM% run --username %USERNAME% --password %PASSWORD% --exe /usr/bin/ss -- /usr/bin/ss -ant"/>
    <add key="Arguments11" value="guestcontrol %VM% run --username %USERNAME% --password %PASSWORD% --exe /bin/sh -- /bin/sh -c &quot;trap : TERM INT; (while true; do sleep 1000; done) &amp; wait&quot;"/>
    <add key="Arguments12" value="guestcontrol %VM% run --username %USERNAME% --password %PASSWORD% --exe /bin/sh -- /bin/sh -c &quot;/usr/bin/docker ps --format json | jq -s | jq '.'&quot;"/>
  	<add key="UserName" value="sergueik"/>
    <add key="Password" value=""/>
    <add key="Script" value="get_performance_counter.sh"/>
    <add key="ScriptArguments" value="--name java --jar example.jwt-stub"/>
    <add key="CollectInterval" value="5000"/>
    <add key="WaitInterval" value="120000"/>
    <add key="LogFile" value="%TEMP%\vboxtest.txt"/>
  </appSettings>
</configuration>
