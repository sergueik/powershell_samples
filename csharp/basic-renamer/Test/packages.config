<packages>
  <package id="NUnit" version="2.6.4" targetFramework="net45" />
  <!-- NOTE: CI/CD: pruning a DLL must be paired with removal of the corresponding .nupkg to defeat NuGet's faulty package-existence check. 
https://stackoverflow.com/questions/29684996/nuget-restore-failing-to-see-that-packages-are-not-installed
NuGet checks that packages directory contains the .nupkg and manifest file for the NuGet package and if so it believes the NuGet package is already installed locall
 -->
</packages>
